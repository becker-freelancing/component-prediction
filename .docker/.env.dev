IMAGE_VERSION=1.0-SNAPSHOT

BACKEND_GATEWAY_PORT=50000

POSTGRES_USER=devuser
POSTGRES_PASSWORD=devpass
POSTGRES_DB=metadatadb
POSTGRES_PORT=5432

STORAGE_QDRANT_HOST=vector-db
STORAGE_QDRANT_PORT=6334
STORAGE_QDRANT_VECTORSIZE=384
STORAGE_QDRANT_ONDISK=false
STORAGE_QDRANT_DISTANCE=COSINE
STORAGE_QDRANT_DATATYPE=FLOAT32

EMBEDDING_USE_L2_NORMALIZATION=true
# Max. token length per chunk
EMBEDDING_CHUNK_SIZE=256
# No. of overlapping tokens between chunks
EMBEDDING_CHUNK_OVERLAP=32
# No. of token to enable chunking (e.g., 1.5 * chunksize to 2 * chunksize)
EMBEDDING_CHUNK_THRESHOLD=384

SOURCE_EXTRACTION_SERVICE_PREFIX=source-extract-service
SOURCE_EXTRACTION_GRPC_PORT=9090

SPRING_PROFILES=dev
